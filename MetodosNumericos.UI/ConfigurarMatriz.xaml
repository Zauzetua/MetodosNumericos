<Window x:Class="MetodosNumericos.UI.ConfigurarMatriz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Matriz"
        Height="634"
        Width="828"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa">

    <Border CornerRadius="12"
            Background="White"
            Padding="20"
            Margin="10"
            BorderBrush="#d0d0d0"
            BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top"
                  Margin="0,0,0,10"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Tamaño (n):"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtN"
                         Grid.Column="1"
                         Width="60"
                         Height="28"
                         Margin="8,0,0,0"
                         FontSize="14"
                         Padding="2"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         BorderBrush="#ccc"
                         BorderThickness="1"/>

               
                <Border Grid.Column="2"
                        Width="1"
                        Margin="8,0"
                        Background="#e6e6e6"
                        VerticalAlignment="Stretch"/>

                <Button Grid.Column="3"
                        Content="?"
                        Click="BtnAyuda_Click"
                        Padding="12,6"
                        Margin="0,0,0,0"
                        Background="#0061FF"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Arial"
                        Height="34"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Width="35"/>

                <Button Grid.Column="4"
                        Content="Generar matriz"
                        Click="BtnGenerar_Click"
                        Padding="12,6"
                        Margin="0,0,0,0"
                        Background="#0061FF"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Arial"
                        Height="34"
                        FontSize="15"
                        FontWeight="SemiBold"

                        Width="150"/>

                <Button x:Name="btnPrueba"
                        Grid.Column="6"
                        Content="Prueba"
                        Height="34"
                        Width="130"
                        FontFamily="Arial"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#0061FF"
                        Foreground="White"
                        Click="btnMatrizPrueba"/>
            </Grid>
            <Separator DockPanel.Dock="Top"
                       Margin="0,0,0,10"/>
            <Border DockPanel.Dock="Top"
                    CornerRadius="8"
                    BorderBrush="#ccc"
                    BorderThickness="1"
                    Padding="8"
                    Background="#fafafa">
                <ScrollViewer x:Name="scrollViewer"
                              Width="740"
                              Height="400"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="gridMatriz"/>
                </ScrollViewer>
            </Border>
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">
                <Button Content="Aceptar"
                        Width="120"
                        Height="35"
                        Background="#28a745"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnAceptar_Click"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
