<UserControl x:Class="MetodosNumericos.UI.RegresionLinealMultiple"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MetodosNumericos.UI"
             mc:Ignorable="d"
             Background="#FAFAFA"
             Height="460" Width="760">

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Padding="10" Margin="0,0,0,10"
                CornerRadius="5" BorderBrush="#DDD" BorderThickness="1" Background="White">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Número de variables independientes:"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
				<ComboBox x:Name="cmbNumVariables" Width="60"
                         SelectionChanged="cmbNumVariables_SelectionChanged">
					<ComboBoxItem Content="2"/>
					<ComboBoxItem Content="3"/>
					<ComboBoxItem Content="4"/>
					<ComboBoxItem Content="5"/>
				</ComboBox>
				<Button x:Name="btnLimpiar" Content="Limpiar"
                        Width="60" Margin="10,0,0,0" Click="btnLimpiar_Click"/>
				<Button x:Name="btnEjemplo" Content="Ejemplo"
                        Width="60" Margin="10,0,0,0" Click="btnEjemplo_Click"/>
			</StackPanel>
		</Border>

		<Border Grid.Row="1" Padding="10" Margin="0,0,0,10"
                CornerRadius="5" BorderBrush="#DDD" BorderThickness="1" Background="White">
			<StackPanel x:Name="pnlVariables" Orientation="Horizontal">
				<ItemsControl x:Name="icVariables">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="0,0,10,0">
								<TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,5,0"/>
								<TextBox Width="70" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<Button x:Name="btnAgregarPunto" Content="Agregar"
                        Width="60" Click="btnAgregarPunto_Click"/>
				<Button x:Name="btnCalcular" Content="Calcular"
                        Width="60" Margin="10,0,0,0" Click="btnCalcular_Click"/>
			</StackPanel>
		</Border>

		<Grid Grid.Row="2" Margin="0,0,0,108">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*"/>
				<ColumnDefinition Width="1.2*"/>
			</Grid.ColumnDefinitions>

			<GroupBox Header="Puntos Ingresados" Grid.Column="0" Margin="0">
				<DataGrid x:Name="dgPuntos" AutoGenerateColumns="True"
                         IsReadOnly="True" Margin="5"
                         HeadersVisibility="Column"
                         AlternatingRowBackground="#F5F5F5"
                         CanUserAddRows="False"/>
			</GroupBox>

			<GroupBox Header="Matriz de Coeficientes" Grid.Column="1" Margin="0">
				<DataGrid x:Name="dgMatriz" AutoGenerateColumns="True"
                         IsReadOnly="True" Margin="5"
                         HeadersVisibility="Column"
                         AlternatingRowBackground="#F5F5F5"
                         CanUserAddRows="False"/>
			</GroupBox>
		</Grid>

		<Border Grid.Row="2" Margin="0,205,0,38" Padding="10"
                BorderBrush="#DDD" BorderThickness="1" CornerRadius="5"
                Background="White" Grid.RowSpan="2">
			<TextBlock x:Name="txtEcuacion"
                      TextWrapping="Wrap"
                      FontWeight="Bold"
                      FontSize="16"
                      Foreground="#333"
                      TextAlignment="Center"/>
		</Border>
	</Grid>
</UserControl>