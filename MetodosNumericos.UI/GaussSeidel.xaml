<UserControl x:Class="MetodosNumericos.UI.GaussSeidel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MetodosNumericos.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Label Content="Resolver sistema mediante Gauss-Seidel" HorizontalAlignment="Center" Margin="0,6,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="22" FontWeight="Bold"/>
        <DataGrid x:Name="dgResultados" Margin="27,57,34,140" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" FontFamily="Arial">
            <DataGrid.Columns>

            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnCalcular" Content="Calcular" HorizontalAlignment="Center" Margin="0,321,0,0" VerticalAlignment="Top" Height="40" Width="120" FontFamily="Arial" FontSize="18" Background="#FF0061FF" Foreground="White" Click="btnCalcular_Click"/>
        <Button x:Name="btnConfigurarMatriz" Content="Configurar Matriz" HorizontalAlignment="Left" Margin="98,321,0,0" VerticalAlignment="Top" Height="40" Width="151" FontFamily="Arial" FontSize="18" Background="#FF0061FF" Foreground="White" Click="btnConfigurar_Click" RenderTransformOrigin="-0.985,0.7"/>
        <Button x:Name="btnLimpiar" Content="Limpiar" HorizontalAlignment="Left" Margin="546,321,0,0" VerticalAlignment="Top" Height="40" Width="151" FontFamily="Arial" FontSize="18" Background="#FF0061FF" Foreground="White" Click="btnLimpiar_Click" RenderTransformOrigin="-0.985,0.7"/>

    </Grid>
</UserControl>
