<UserControl x:Class="MetodosNumericos.UI.Gauss"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MetodosNumericos.UI"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Label Content="Resolver sistema (Gauss con pivoteo)" HorizontalAlignment="Center" Margin="0,6,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="22" FontWeight="Bold"/>

        <Label Content="Dimension:" HorizontalAlignment="Left" Margin="20,58,0,0" VerticalAlignment="Top" Width="90" FontFamily="Arial" FontWeight="Bold"/>
        <ComboBox x:Name="cbDimension" HorizontalAlignment="Left" Margin="120,58,0,0" VerticalAlignment="Top" Width="80" Height="26" SelectedIndex="0">
            <System:String>2</System:String>
            <System:String>3</System:String>
            <System:String>4</System:String>
        </ComboBox>

        <Button x:Name="btnGenerar" Content="Generar campos" HorizontalAlignment="Left" Margin="220,55,0,0" VerticalAlignment="Top" Height="30" Width="120" FontFamily="Arial" FontSize="14" Background="#FF0061FF" Foreground="White" Click="btnGenerar_Click"/>

        <ScrollViewer HorizontalAlignment="Left" Height="250" Margin="20,100,0,0" VerticalAlignment="Top" Width="360">
            <StackPanel x:Name="spEntradasMatriz" Orientation="Vertical" />
        </ScrollViewer>

        <Button x:Name="btnCalcular" Content="Calcular" HorizontalAlignment="Left" Margin="56,338,0,0" VerticalAlignment="Top" Height="40" Width="120" FontFamily="Arial" FontSize="18" Background="#FF0061FF" Foreground="White" Click="btnCalcular_Click"/>
        <Button x:Name="btnReiniciar" Content="Reiniciar" HorizontalAlignment="Left" Margin="196,338,0,0" VerticalAlignment="Top" Height="40" Width="120" FontFamily="Arial" FontSize="18" Background="#FF0061FF" Foreground="White" Click="btnReiniciar_Click"/>

        <Label Content="Resultado (vector x)" HorizontalAlignment="Left" Margin="410,58,0,0" VerticalAlignment="Top" Width="200" FontFamily="Arial" FontSize="18" FontWeight="Bold"/>
        <DataGrid x:Name="dgResultados" Margin="410,100,20,100" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FontFamily="Arial">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Indice" Width="80" Binding="{Binding Variable}"/>
                <DataGridTextColumn Header="Valor" Width="*" Binding="{Binding Valor}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="txtMensajes" HorizontalAlignment="Left" Margin="483,0,0,46" VerticalAlignment="Bottom" Height="40" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Arial" Width="246"/>
        <Button x:Name="btnAyuda" Content="?" HorizontalAlignment="Left" Margin="695,24,0,0" VerticalAlignment="Top" Background="#FF4D6FF9" Foreground="White" Height="30" Width="34" FontFamily="Arial" FontSize="20" Click="btnAyuda_Click"/>
        <ComboBox x:Name="cbxMetodo" Margin="126,291,0,0" VerticalAlignment="Top" SelectedIndex="0" FontFamily="Arial" FontSize="18" HorizontalAlignment="Left" Width="130">
            <System:String>Gauss</System:String>
            <System:String>Gauss-Jordan</System:String>
        </ComboBox>
    </Grid>
</UserControl>
